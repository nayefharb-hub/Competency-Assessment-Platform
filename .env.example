# Copy to .env.local and fill in from Supabase → Project Settings → API.
# .env.local is gitignored — never commit real keys.

# Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# anon / publishable key — safe for the browser (used for auth only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# service_role / secret key — FULL DATABASE ACCESS, bypasses RLS.
# Server-side only. Never import this into a client component.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
