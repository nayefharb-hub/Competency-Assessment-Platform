    {
      "code": "4.3.3.2",
      "target_level": 3,
      "priority": "Medium",
      "active": true,
      "reason": "Health, safety and environmental content applies at KIB in different form from physical delivery - digital ergonomics and DSE, psychosocial safety during transformation, e-waste from system migrations, and CBK cyber and operational resilience requirements. No measure is out of scope once correctly interpreted.",
      "kib_note": "Guidance block written. Sharia compliance deliberately excluded here - sits with 4.3.3.1 and 4.3.3.3.",
      "target_source": "APM (published)"
    },
    {
      "code": "4.3.3.3",
      "target_level": 3,
      "priority": "High",
      "active": true,
      "reason": null,
      "kib_note": "No seniority flag - ethical conduct is absolute from day one.",
      "target_source": "APM (published)"
    },
    {
      "code": "4.3.3.4",
      "target_level": 3,
      "priority": "Low",
      "active": true,
      "reason": "Reinstated. Originally excluded as not applicable at KIB today. Environmental obligations under Kuwait Environmental Protection Law No. 42 of 2014 (as amended by Law No. 99 of 2015) apply to project e-waste from system migrations, and Boursa Kuwait ESG guidance bears on vendor selection. Retained at Low pending confirmation of KIB's ESG position.",
      "kib_note": "Reason type: not applicable at KIB today - EXPIRED and reversed in-session.",
      "target_source": "APM (published)"
    },
    {
      "code": "4.3.3.5",
      "target_level": 3,
      "priority": "Medium",
      "active": true,
      "reason": "Identifying and applying relevant professional standards is PM work. Developing custom-made standards and managing the risk of applying a standard are closer to PMO methodology ownership, which is the Head of PMO's role.",
      "kib_note": "Senior baseline / junior target (provisional)",
      "target_source": "APM (published)"
    },
    {
      "code": "4.3.3.6",
