    {
      "code": "4.3.2.6",
      "target_level": null,
      "priority": "Low",
      "active": false,
      "reason": "HR owns contracts, temporary employment, salaries, incentives and training at KIB. A PM does not engage HR directly for resourcing - that runs through the PMO and the line. No measure describes work a KIB PM performs.",
      "kib_note": "Reason type: belongs to another department (permanent)",
      "target_source": "n/a — inactive"
    },
    {
      "code": "4.3.2.7",
      "target_level": 3,
      "priority": "Medium",
      "active": true,
      "reason": "Knowing Finance's processes, distinguishing compulsory from optional and reporting financial status are PM work. Knowing funding models (public, private, PPP, subsidies) is not a KIB PM's decision.",
      "kib_note": "Senior baseline / junior target (provisional). Islamic-banking language review needed at Phase 2.",
      "target_source": "APM (published)"
    },
    {
