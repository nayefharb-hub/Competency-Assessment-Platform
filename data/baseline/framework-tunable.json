      "target_source": "Derived (priority rule)"
    },
    {
      "code": "4.3.2.3",
      "target_level": 2,
      "priority": "Medium",
      "active": true,
      "reason": "Two of three measures are explanatory; the third (communicating within the portfolio to manage the project successfully) is an active behaviour that is real under KIB's matrix structure with a portfolio manager in post.",
